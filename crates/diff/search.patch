+    /// Actual painted positions for a search hit, including wrapped text.
+    pub(crate) fn search_target(
+        &self, file: usize, side: DiffSide, index: usize, source: Range<usize>,
+    ) -> Option<(Bounds<Pixels>, Point<Pixels>, Point<Pixels>, Pixels)> {
+        let matching = || self.runs.iter().filter(|run| {
+            run.file == file && run.side == side && run.line_ix == index
+        });
+        let first = matching().next()?;
+        let line = &first.document.lines(side)[index];
+        let display = line.display_range(source);
+        let position = |offset| matching().find_map(|run| {
+            (run.display_range.contains(&offset) || offset == line.display().len())
+                .then(|| run.layout.position_for_index(offset - run.display_range.start))
+                .flatten()
+        });
+        Some((self.bounds, position(display.start)?, position(display.end)?, first.layout.line_height()))
+    }
