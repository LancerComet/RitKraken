+    /// Resolve chosen regions, retaining the original markers in every unchosen region.
+    pub fn conflict_output(&self, resolutions: &[Option<DiffConflictResolution>]) -> Option<String> {
+        if self.status() != DiffFileStatus::Conflicted || resolutions.len() != self.conflicts().len() {
+            return None;
+        }
+        let source = self.conflict_source()?;
+        let ranges = line_ranges(source);
+        let span = |lines: Range<usize>| -> Option<Range<usize>> {
+            let start = ranges.get(lines.start.checked_sub(1)?)?.start;
+            let end_line = lines.end.checked_sub(1)?;
+            let end = if end_line == ranges.len() { source.len() } else { ranges.get(end_line)?.start };
+            Some(start..end)
+        };
+        let mut output = String::with_capacity(source.len());
+        let mut cursor = 0;
+        for (conflict, resolution) in self.conflicts().iter().zip(resolutions) {
+            let block = span(conflict.lines())?;
+            output.push_str(&source[cursor..block.start]);
+            if let Some(resolution) = resolution {
+                let parts = match resolution {
+                    DiffConflictResolution::Current => vec![conflict.current_lines()],
+                    DiffConflictResolution::Incoming => vec![conflict.incoming_lines()],
+                    DiffConflictResolution::Both => vec![conflict.current_lines(), conflict.incoming_lines()],
+                };
+                for lines in parts { output.push_str(&source[span(lines)?]); }
+            } else {
+                output.push_str(&source[block.clone()]);
+            }
+            cursor = block.end;
+        }
+        output.push_str(&source[cursor..]);
+        Some(output)
     }
 
